<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Phase 1 hanya butuh INTERNET. Permission lain (kamera, mikrofon,
         lokasi, notifikasi, media) akan ditambahkan per-phase saat
         fiturnya benar-benar diimplementasi — bukan diminta di awal
         "untuk jaga-jaga". -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".NazeVerApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.NazeVer"
        android:networkSecurityConfig="@xml/network_security_config">
        <!--
          allowBackup=false + fullBackupContent=false:
          mencegah Android auto-backup menyalin EncryptedSharedPreferences
          (session token) ke Google Drive backup. Lihat docs/ARCHITECTURE.md
          bagian "Local Data Protection".
        -->

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NazeVer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link untuk consume pairing invite: nazever://pair?token=... -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nazever" android:host="pair" />
            </intent-filter>
        </activity>
    </application>
</manifest>
