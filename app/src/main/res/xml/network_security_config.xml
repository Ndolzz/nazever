<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Seluruh traffic wajib HTTPS/TLS. Tidak ada exception cleartext,
         bahkan untuk debug build, supaya kebiasaan aman terbawa terus. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
