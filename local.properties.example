# Salin file ini jadi "local.properties" (tanpa .example) lalu isi nilai asli.
# JANGAN PERNAH commit local.properties yang sudah berisi nilai asli.

sdk.dir=/path/to/Android/sdk

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

# SUPABASE_SERVICE_ROLE_KEY TIDAK ADA DI SINI.
# Service role key hanya di-set sebagai secret di dashboard Supabase
# (Edge Functions > Secrets), tidak pernah di perangkat/APK.
